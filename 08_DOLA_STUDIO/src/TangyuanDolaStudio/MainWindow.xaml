<Window x:Class="TangyuanDolaStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="汤圆 Dola Studio"
        Width="1360" Height="820"
        MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171A22" BorderBrush="#2A2F3A" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="汤圆 Dola Studio" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="10" Background="#232936">
                        <TextBlock Text="P1 Session Lab" Foreground="#B8C2D8" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TopProfileText" Text="未选择账号"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#AEB7C8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开下载目录" Click="OpenDownloads_Click" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="Dola 首页" Click="Home_Click" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="285"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#14171E" BorderBrush="#2A2F3A" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="账号实例" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ 添加" Click="AddProfile_Click" Padding="10,5"/>
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="ProfilesList" Margin="0,12,0,12"
                             Background="#10131A" BorderBrush="#2A2F3A"
                             Foreground="White" SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="#6CDE9B" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="独立 WebView2 Session" Foreground="#778198" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <Button Content="打开 / 切换账号" Click="OpenProfile_Click" Margin="0,0,0,7" Padding="10,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="重命名" Click="RenameProfile_Click" Margin="0,0,4,0" Padding="8,6"/>
                            <Button Grid.Column="1" Content="删除" Click="DeleteProfile_Click" Margin="4,0,0,0" Padding="8,6"/>
                        </Grid>
                        <Button Content="停止当前浏览器" Click="StopBrowser_Click" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#0B0D12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#11141B" BorderBrush="#2A2F3A" BorderThickness="0,0,0,1">
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="←" Click="Back_Click" Width="36" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="→" Click="Forward_Click" Width="36" Margin="0,0,5,0"/>
                        <Button Grid.Column="2" Content="↻" Click="Refresh_Click" Width="36" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" x:Name="AddressBox" VerticalContentAlignment="Center"
                                 Background="#20242E" Foreground="White" BorderBrush="#343A48"
                                 KeyDown="AddressBox_KeyDown"/>
                        <Button Grid.Column="4" Content="前往" Click="Navigate_Click" Margin="8,0,0,0" Padding="12,0"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" x:Name="BrowserHost" Background="White">
                    <StackPanel x:Name="BrowserPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Dola Browser" FontSize="28" FontWeight="SemiBold" Foreground="#2B3342" HorizontalAlignment="Center"/>
                        <TextBlock Text="从左侧选择账号，然后点击“打开 / 切换账号”" Margin="0,10,0,0" Foreground="#677286"/>
                        <TextBlock Text="每个账号使用独立 User Data Folder" Margin="0,4,0,0" Foreground="#8993A5" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="#14171E" BorderBrush="#2A2F3A" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="当前实例" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <Border Margin="0,12,0,0" Padding="12" Background="#1B1F29" CornerRadius="6">
                            <StackPanel>
                                <TextBlock x:Name="ProfileNameText" Text="未选择" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProfileIdText" Text="-" Foreground="#778198" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SessionStateText" Text="浏览器：未启动" Foreground="#9BA6BA" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Seedance 能力" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,0"/>
                        <Border Margin="0,10,0,0" Padding="12" Background="#1B1F29" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="模型：待检测" Foreground="#CFD6E4"/>
                                <TextBlock Text="5s / 10s / 15s：待检测" Foreground="#9BA6BA" Margin="0,7,0,0"/>
                                <TextBlock Text="30s：P1 暂不检测" Foreground="#E0B86B" Margin="0,7,0,0"/>
                                <TextBlock Text="30 秒必须在后续 Gate 用真实生成文件验证" Foreground="#778198" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Session Gate" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,0"/>
                        <Border Margin="0,10,0,0" Padding="12" Background="#1B1F29" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="① A / B 分别登录" Foreground="#B8C2D8"/>
                                <TextBlock Text="② 完全关闭软件" Foreground="#B8C2D8" Margin="0,5,0,0"/>
                                <TextBlock Text="③ 重启后确认各自保持" Foreground="#B8C2D8" Margin="0,5,0,0"/>
                                <TextBlock Text="④ 连续切换 20 次不串号" Foreground="#B8C2D8" Margin="0,5,0,0"/>
                                <TextBlock Text="⑤ 清除 A 不影响 B" Foreground="#B8C2D8" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#171A22" BorderBrush="#2A2F3A" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="#9BA6BA" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="WebView2 · Windows x64" VerticalAlignment="Center" Foreground="#657086" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
