                              "cue": {
                                "identity": {
                                  "kind": "narration"
                                },
                                "rows": [
                                  {
                                    "text": "阿笙把灯挂上檐角。雾还没有散，但晚归的人，终于看见了家的方向。"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "identity": {
                                  "kind": "narration"
                                },
                                "rows": [
                                  {
                                    "text": "第一章 · 完\n你已完成原创试玩。可继续探索，或按 F5 留下这段归途。"
                                  }
                                ]
                              }
                            }
                          ],
