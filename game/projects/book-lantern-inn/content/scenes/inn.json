                                  "cue": {
                                    "identity": {
                                      "kind": "actor",
                                      "actor": "keeper"
                                    },
                                    "rows": [
                                      {
                                        "text": "山道的灯熄了。雾林里还有一枚灯芯，能替我找回来吗？"
