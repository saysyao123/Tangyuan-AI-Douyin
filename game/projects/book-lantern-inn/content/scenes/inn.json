                                    ]
                                  }
                                },
                                {
                                  "kind": "dialog",
                                  "cue": {
                                    "identity": {
                                      "kind": "actor",
                                      "actor": "keeper"
                                    },
                                    "rows": [
                                      {
                                        "text": "往右上方的路牌走，按空格进入雾林。先存个档吧，F5 保存，F9 读取。"
                                      }
                                    ]
                                  }
                                },
                                {
                                  "kind": "setFlag",
                                  "flag": "quest_started",
                                  "value": true
                                }
                              ]
                            }
                          ]
