                      ]
                    }
                  },
                  {
                    "kind": "clearDialog"
                  }
                ],
                "else": [
                  {
                    "kind": "setFlag",
                    "flag": "fruit_used",
                    "value": true
                  },
                  {
                    "kind": "increaseHpMp",
                    "delta": 20,
                    "pools": "hp"
                  },
                  {
                    "kind": "clearDialog"
                  },
                  {
                    "kind": "dialog",
                    "cue": {
                      "slot": "bottom",
                      "identity": {
                        "kind": "actor",
                        "actor": "hero",
                        "portrait": {
                          "kind": "default",
                          "side": "right"
                        }
                      },
                      "rows": [
                        {
                          "text": "果实入口化成暖流。寒意退去，长久缠着你的虚弱感，像终于松开了一道枷锁。"
                        }
                      ]
                    }
                  },
                  {
                    "kind": "clearDialog"
                  }
                ]
              }
            ]
          }
        }
