{
  "id": "snow-yard",
  "mapId": "snow-yard",
  "entry": {
    "pos": {
      "col": 27,
      "row": 1,
      "height": 0
    },
    "facing": "right"
  },
  "entities": [
    {
      "id": "snow-large",
      "label": "堆大雪人",
      "pos": {
        "col": 32,
        "row": -1,
        "height": 0
      },
      "sprite": "snow-pile",
      "facing": "right",
      "collide": true,
      "behaviors": {
        "trigger": {
          "main": {
            "label": "交互",
            "order": 0,
            "flow": {
              "kind": "stages",
              "initial": "main",
              "stages": [
                {
                  "id": "main",
                  "body": [
                    {
                      "kind": "branch",
                      "cond": {
                        "kind": "flag",
                        "flag": "snowman_large",
                        "is": true
                      },
                      "then": [
                        {
                          "kind": "clearDialog"
                        },
                        {
                          "kind": "dialog",
                          "cue": {
                            "slot": "bottom",
                            "identity": {
                              "kind": "narration"
                            },
                            "rows": [
                              {
                                "text": "两个雪人还并肩站着。可以按 F5 保存这一刻。"
                              }
                            ]
                          }
                        },
                        {
                          "kind": "clearDialog"
                        }
                      ],
                      "else": [
                        {
                          "kind": "moveParty",
                          "to": {
                            "col": 31,
                            "row": -1,
                            "height": 0
                          },
                          "speed": "normal"
                        },
                        {
                          "kind": "clearDialog"
                        },
                        {
                          "kind": "dialog",
                          "cue": {
                            "slot": "bottom",
                            "identity": {
                              "kind": "actor",
                              "actor": "hero",
                              "portrait": {
                                "kind": "default",
                                "side": "right"
                              }
                            },
                            "rows": [
                              {
                                "text": "你把松雪拢成大球，又歪歪地叠了两层。怎么看，都不像那些漂亮的雪雕。"
                              }
                            ]
                          }
                        },
                        {
                          "kind": "clearDialog"
                        },
                        {
                          "kind": "wait",
                          "ms": 350
                        },
                        {
                          "kind": "setEntityState",
                          "target": {
                            "scene": "snow-yard",
                            "entity": "snow-large"
                          },
                          "state": 0
                        },
                        {
                          "kind": "setEntityState",
                          "target": {
                            "scene": "snow-yard",
                            "entity": "big-finished"
                          },
                          "state": 1
                        },
                        {
                          "kind": "setFlag",
                          "flag": "snowman_large",
                          "value": true
                        },
                        {
                          "kind": "branch",
                          "cond": {
                            "kind": "all",
                            "of": [
                              {
                                "kind": "flag",
                                "flag": "snowman_large",
                                "is": true
                              },
                              {
                                "kind": "flag",
                                "flag": "snowman_small",
                                "is": true
                              }
                            ]
                          },
                          "then": [
                            {
                              "kind": "moveParty",
                              "to": {
                                "col": 30,
                                "row": 0,
                                "height": 0
                              },
                              "speed": "normal"
                            },
                            {
                              "kind": "setPartyFacing",
                              "facing": "right"
                            },
                            {
                              "kind": "cameraPan",
                              "dx": 2,
                              "dy": 0,
                              "frames": 12
                            },
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "slot": "bottom",
                                "identity": {
                                  "kind": "narration"
                                },
                                "rows": [
                                  {
                                    "text": "雪越下越密。院里两个歪歪扭扭、一大一小的雪人紧紧挨着。世界很冷，家人却在身旁。第二幕完成。"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "cameraSnap"
                            },
                            {
                              "kind": "setFlag",
                              "flag": "night_complete",
                              "value": true
                            }
                          ],
                          "else": [
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "slot": "bottom",
                                "identity": {
                                  "kind": "actor",
                                  "actor": "child",
                                  "portrait": {
                                    "kind": "default",
                                    "side": "right"
                                  }
                                },
                                "rows": [
                                  {
                                    "text": "再把旁边那一个也堆好吧。"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "clearDialog"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "pages": [
        {
          "id": "default",
          "label": "交互",
          "trigger": "main",
          "triggerActivation": {
            "on": "interact",
