    {
      "id": "star-shop",
      "label": "购物商店 · 果实1000",
      "pos": {
        "col": 29,
        "row": -3,
        "height": 0
      },
      "sprite": "star-terminal",
      "facing": "right",
      "collide": true,
      "behaviors": {
        "trigger": {
          "main": {
            "label": "交互",
            "order": 0,
            "flow": {
              "kind": "stages",
              "initial": "main",
              "stages": [
                {
                  "id": "main",
                  "body": [
                    {
                      "kind": "clearDialog"
                    },
                    {
                      "kind": "dialog",
                      "cue": {
                        "slot": "bottom",
                        "identity": {
                          "kind": "narration"
                        },
                        "rows": [
                          {
                            "text": "只有星辰果实亮着，售价1000。当前余额不足；其他商品仍隐在雾里。"
                          }
                        ]
                      }
                    },
                    {
                      "kind": "clearDialog"
                    },
                    {
                      "kind": "setFlag",
                      "flag": "shop_seen",
                      "value": true
                    }
                  ]
                }
              ]
            }
          }
        }
      },
