    {
      "id": "lottery",
      "label": "抽奖中心 · 每次100",
      "pos": {
        "col": 30,
        "row": 3,
        "height": 0
      },
      "sprite": "draw-wheel",
      "facing": "right",
      "collide": true,
      "behaviors": {
        "trigger": {
          "main": {
            "label": "交互",
            "order": 0,
            "flow": {
              "kind": "stages",
              "initial": "main",
              "stages": [
                {
                  "id": "main",
                  "body": [
                    {
                      "kind": "branch",
                      "cond": {
                        "kind": "flag",
                        "flag": "fruit_won",
                        "is": true
                      },
                      "then": [
                        {
                          "kind": "clearDialog"
                        },
                        {
                          "kind": "dialog",
                          "cue": {
                            "slot": "bottom",
                            "identity": {
                              "kind": "narration"
                            },
                            "rows": [
                              {
                                "text": "这轮七次抽取已经结束，奖励不会再次发放。"
                              }
                            ]
                          }
                        },
                        {
                          "kind": "clearDialog"
                        }
                      ],
                      "else": [
                        {
                          "kind": "branch",
                          "cond": {
                            "kind": "all",
                            "of": [
                              {
                                "kind": "flag",
                                "flag": "income_seen",
                                "is": true
                              },
                              {
                                "kind": "flag",
                                "flag": "shop_seen",
                                "is": true
                              }
                            ]
                          },
                          "then": [
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "slot": "bottom",
                                "identity": {
                                  "kind": "narration"
                                },
                                "rows": [
                                  {
                                    "text": "抽一次需要100点。本段按故事顺序演出六次落空和第七次奖励。要开始这一次吗？"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "confirm",
                              "onYes": [
                                {
                                  "kind": "branch",
                                  "cond": {
                                    "kind": "var",
                                    "var": "emotion",
                                    "op": ">=",
                                    "value": 100
                                  },
                                  "then": [
                                    {
                                      "kind": "addVar",
                                      "var": "emotion",
                                      "delta": -100
                                    },
                                    {
                                      "kind": "playEntityAction",
                                      "target": {
                                        "scene": "mind-tree",
                                        "entity": "lottery"
                                      },
                                      "sprite": "draw-wheel",
                                      "action": "roll",
                                      "loop": false,
                                      "wait": true
                                    },
                                    {
                                      "kind": "branch",
                                      "cond": {
                                        "kind": "var",
                                        "var": "draws",
                                        "op": "<",
                                        "value": 6
                                      },
                                      "then": [
                                        {
                                          "kind": "addVar",
                                          "var": "draws",
                                          "delta": 1
                                        },
                                        {
                                          "kind": "setEntityFrame",
                                          "target": {
                                            "scene": "mind-tree",
                                            "entity": "lottery"
                                          },
                                          "frame": 6
                                        },
                                        {
                                          "kind": "clearDialog"
                                        },
                                        {
                                          "kind": "dialog",
                                          "cue": {
                                            "slot": "bottom",
                                            "identity": {
                                              "kind": "actor",
                                              "actor": "hero",
                                              "portrait": {
                                                "kind": "default",
                                                "side": "right"
                                              }
                                            },
                                            "rows": [
                                              {
                                                "text": "谢谢参与。你盯着转盘，有点不敢相信这么神奇的系统也会落空。"
                                              }
                                            ]
                                          }
                                        },
                                        {
                                          "kind": "clearDialog"
                                        }
                                      ],
                                      "else": [
                                        {
                                          "kind": "addVar",
                                          "var": "draws",
                                          "delta": 1
                                        },
                                        {
                                          "kind": "setEntityFrame",
                                          "target": {
                                            "scene": "mind-tree",
                                            "entity": "lottery"
                                          },
                                          "frame": 7
                                        },
                                        {
                                          "kind": "giveItem",
                                          "itemId": "cleansing-fruit",
                                          "count": 1
                                        },
                                        {
                                          "kind": "setFlag",
                                          "flag": "fruit_won",
                                          "value": true
                                        },
                                        {
                                          "kind": "clearDialog"
                                        },
                                        {
                                          "kind": "dialog",
                                          "cue": {
                                            "slot": "bottom",
                                            "identity": {
                                              "kind": "narration"
                                            },
                                            "rows": [
                                              {
                                                "text": "迷雾散去，一枚红色果实停在指针下。洗髓果实已存入原生物品栏。"
                                              }
                                            ]
                                          }
                                        },
                                        {
                                          "kind": "clearDialog"
                                        },
                                        {
                                          "kind": "clearDialog"
                                        },
                                        {
                                          "kind": "dialog",
                                          "cue": {
                                            "slot": "bottom",
                                            "identity": {
                                              "kind": "narration"
                                            },
                                            "rows": [
                                              {
                                                "text": "按 Esc 打开原生菜单：物品 → 使用 → 洗髓果实。使用会消耗这一枚果实。"
                                              }
                                            ]
                                          }
                                        },
                                        {
                                          "kind": "clearDialog"
                                        }
                                      ]
                                    }
                                  ],
                                  "else": [
                                    {
                                      "kind": "clearDialog"
                                    },
                                    {
                                      "kind": "dialog",
                                      "cue": {
                                        "slot": "bottom",
                                        "identity": {
                                          "kind": "narration"
                                        },
                                        "rows": [
                                          {
                                            "text": "余额不足100，不能继续抽取。"
                                          }
                                        ]
                                      }
                                    },
                                    {
                                      "kind": "clearDialog"
                                    }
                                  ]
                                }
                              ],
                              "onNo": []
                            }
                          ],
                          "else": [
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "slot": "bottom",
                                "identity": {
                                  "kind": "narration"
                                },
                                "rows": [
                                  {
                                    "text": "这是掌心树纹映出的意识空间。靠近三个光标按空格查看；方向键选择，空格确认，Esc取消。"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "clearDialog"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
