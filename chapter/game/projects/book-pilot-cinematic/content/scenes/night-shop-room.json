{
  "id": "night-shop-room",
  "mapId": "night-shop-room",
  "entry": {
    "pos": {
      "col": 25,
      "row": 2,
      "height": 0
    },
    "facing": "right"
  },
  "entities": [
    {
      "id": "shopkeeper",
      "label": "购买两包面 · 5元",
      "pos": {
        "col": 29,
        "row": -1,
        "height": 0
      },
      "facing": "right",
      "collide": true,
      "behaviors": {
        "trigger": {
          "main": {
            "label": "交互",
            "order": 0,
            "flow": {
              "kind": "stages",
              "initial": "main",
              "stages": [
                {
                  "id": "main",
                  "body": [
                    {
                      "kind": "branch",
                      "cond": {
                        "kind": "flag",
                        "flag": "noodles_bought",
                        "is": true
                      },
                      "then": [
                        {
                          "kind": "clearDialog"
                        },
                        {
                          "kind": "dialog",
                          "cue": {
                            "slot": "bottom",
                            "identity": {
                              "kind": "actor",
                              "actor": "shopkeeper",
                              "portrait": {
                                "kind": "default",
                                "side": "right"
                              }
                            },
                            "rows": [
                              {
                                "text": "两包面已经拿好了。该沿雪路回家了。"
                              }
                            ]
                          }
                        },
                        {
                          "kind": "clearDialog"
                        }
                      ],
                      "else": [
                        {
                          "kind": "branch",
                          "cond": {
                            "kind": "hasMoney",
                            "atLeast": 5
                          },
                          "then": [
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "slot": "bottom",
                                "identity": {
                                  "kind": "actor",
                                  "actor": "hero",
                                  "portrait": {
                                    "kind": "default",
                                    "side": "right"
                                  }
                                },
                                "rows": [
                                  {
                                    "text": "老板，红烧牛肉面。"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "giveMoney",
                              "delta": -5
                            },
                            {
                              "kind": "giveItem",
                              "itemId": "noodles",
                              "count": 2
                            },
                            {
                              "kind": "setFlag",
                              "flag": "noodles_bought",
                              "value": true
                            },
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "slot": "bottom",
                                "identity": {
                                  "kind": "narration"
                                },
                                "rows": [
                                  {
                                    "text": "便利店老板看着你脸上的血污，话到嘴边又咽了回去。你递出五元，从货架取了两包。"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "clearDialog"
                            }
                          ],
                          "else": [
                            {
                              "kind": "clearDialog"
                            },
                            {
                              "kind": "dialog",
                              "cue": {
                                "slot": "bottom",
                                "identity": {
                                  "kind": "actor",
                                  "actor": "hero",
                                  "portrait": {
                                    "kind": "default",
                                    "side": "right"
                                  }
                                },
                                "rows": [
                                  {
                                    "text": "兜里还差五元。先检查一下行囊。"
                                  }
                                ]
                              }
                            },
                            {
                              "kind": "clearDialog"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "pages": [
        {
          "id": "default",
          "label": "交互",
          "trigger": "main",
          "triggerActivation": {
            "on": "interact",
            "range": 1
