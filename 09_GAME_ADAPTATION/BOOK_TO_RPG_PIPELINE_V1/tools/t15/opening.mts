for(const scene of scenes){
 const [w,h]=dimensions[scene.id],props=scene.entities.filter((e:any)=>['rental','wall','crate'].includes(e.sprite));const floor=[],collision=[]
 for(let b=0;b<h*2;b++){const tiles=[],blocks=[];for(let k=0;k<w;k++){const x=(k*2+b%2)*16,y=b*8,n=(b*17+k*31)%101;let tile=22+(b+k)%10;const road=scene.id==='fair'?Math.abs(y-260)<66:Math.abs(y-236)<38;if(road)tile=(scene.id==='courtyard'?12:0)+(b*3+k)%10;if(scene.id==='backstage'&&x>420&&y<230)tile=12+(b+k)%10;tiles.push(tile);let block=x<192||x>w*32-192||y<128||y>h*16-112;for(const e of props){const px=16*(e.pos.col-e.pos.row),py=8*(e.pos.col+e.pos.row),rw=e.sprite==='rental'?86:e.sprite==='wall'?44:12,rh=e.sprite==='rental'?26:8;if(Math.abs(x-px)<rw&&y>=py-rh&&y<=py)block=true}blocks.push(block?1:0)}floor.push(tiles);collision.push(blocks)}
 p['content/scenes/'+scene.id+'.json']=scene;p['content/maps/'+scene.id+'.json']={version:4,width:w,height:h,tilesetRefs:['original'],layers:[{id:'floor',name:cfg.scenes[scene.id],tiles:floor}],collision}
}
